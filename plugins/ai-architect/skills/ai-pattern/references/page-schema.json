{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ManSe404/claude-role-skills/shared/page-schema.json",
 "title": "Skill page",
 "description": "The JSON a skill writes and render_page.py draws. The prose is page-format.md; this file is the contract a tool can check. Cross-references (edge ends, ids, totals) are checked by render_page.py.",
 "type": "object",
 "required": [
  "skill",
  "title",
  "sections"
 ],
 "additionalProperties": false,
 "properties": {
  "skill": {
   "type": "string"
  },
  "archetype": {
   "enum": [
    "decision",
    "map",
    "review",
    "incident",
    "chain",
    "report"
   ]
  },
  "title": {
   "type": "string"
  },
  "subtitle": {
   "type": "string"
  },
  "meta": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/cell"
   }
  },
  "verdict": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string"
    },
    "tone": {
     "$ref": "#/$defs/tone"
    }
   },
   "additionalProperties": false,
   "required": [
    "text"
   ]
  },
  "stats": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string"
     },
     "value": {
      "type": [
       "string",
       "number"
      ]
     },
     "note": {
      "type": "string"
     },
     "tone": {
      "$ref": "#/$defs/tone"
     }
    },
    "additionalProperties": false,
    "required": [
     "label",
     "value"
    ]
   }
  },
  "facts": {
   "$ref": "#/$defs/facts"
  },
  "sections": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/section"
   },
   "minItems": 1
  }
 },
 "$defs": {
  "cell": {
   "type": [
    "string",
    "number",
    "null"
   ]
  },
  "pair": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cell"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "tone": {
   "enum": [
    "ok",
    "warn",
    "bad",
    "info"
   ]
  },
  "flag": {
   "enum": [
    "warn",
    "bad"
   ]
  },
  "ids": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "edge": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string"
    },
    "to": {
     "type": "string"
    },
    "label": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "required": [
    "from",
    "to"
   ]
  },
  "flowstep": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string"
    },
    "to": {
     "type": "string"
    },
    "text": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "required": [
    "from",
    "to",
    "text"
   ]
  },
  "reach": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string"
    },
    "from": {
     "$ref": "#/$defs/ids"
    },
    "targets": {
     "$ref": "#/$defs/ids"
    },
    "stops": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "label",
    "from",
    "targets"
   ]
  },
  "number_or_null": {
   "type": [
    "number",
    "null"
   ]
  },
  "section": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "intro": {
     "type": "string"
    },
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/block"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "title",
    "blocks"
   ]
  },
  "block": {
   "anyOf": [
    {
     "$ref": "#/$defs/block_text"
    },
    {
     "$ref": "#/$defs/block_callout"
    },
    {
     "$ref": "#/$defs/block_list"
    },
    {
     "$ref": "#/$defs/block_table"
    },
    {
     "$ref": "#/$defs/block_kv"
    },
    {
     "$ref": "#/$defs/block_code"
    },
    {
     "$ref": "#/$defs/block_steps"
    },
    {
     "$ref": "#/$defs/block_findings"
    },
    {
     "$ref": "#/$defs/block_graph"
    },
    {
     "$ref": "#/$defs/block_flowchart"
    },
    {
     "$ref": "#/$defs/block_decision"
    },
    {
     "$ref": "#/$defs/block_architecture"
    },
    {
     "$ref": "#/$defs/block_model"
    },
    {
     "$ref": "#/$defs/block_nested"
    },
    {
     "$ref": "#/$defs/block_chart"
    }
   ]
  },
  "block_text": {
   "type": "object",
   "properties": {
    "type": {
     "const": "text"
    },
    "title": {
     "type": "string"
    },
    "text": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "text"
   ]
  },
  "block_callout": {
   "type": "object",
   "properties": {
    "type": {
     "const": "callout"
    },
    "title": {
     "type": "string"
    },
    "text": {
     "type": "string"
    },
    "tone": {
     "$ref": "#/$defs/tone"
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "text"
   ]
  },
  "block_list": {
   "type": "object",
   "properties": {
    "type": {
     "const": "list"
    },
    "title": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "ordered": {
     "type": "boolean"
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "items"
   ]
  },
  "block_table": {
   "type": "object",
   "properties": {
    "type": {
     "const": "table"
    },
    "title": {
     "type": "string"
    },
    "columns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/cell"
      }
     }
    },
    "align": {
     "type": "array",
     "items": {
      "enum": [
       "left",
       "right",
       "center"
      ]
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "columns",
    "rows"
   ]
  },
  "block_kv": {
   "type": "object",
   "properties": {
    "type": {
     "const": "kv"
    },
    "title": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/pair"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "items"
   ]
  },
  "block_code": {
   "type": "object",
   "properties": {
    "type": {
     "const": "code"
    },
    "title": {
     "type": "string"
    },
    "code": {
     "type": "string"
    },
    "where": {
     "type": "string"
    },
    "start": {
     "type": "integer",
     "minimum": 1
    },
    "highlight": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "code"
   ]
  },
  "block_steps": {
   "type": "object",
   "properties": {
    "type": {
     "const": "steps"
    },
    "title": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "title": {
        "type": "string"
       },
       "text": {
        "type": "string"
       },
       "where": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "title"
      ]
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "items"
   ]
  },
  "block_findings": {
   "type": "object",
   "properties": {
    "type": {
     "const": "findings"
    },
    "title": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "severity": {
        "enum": [
         "high",
         "medium",
         "low",
         "info"
        ]
       },
       "title": {
        "type": "string"
       },
       "where": {
        "type": "string"
       },
       "evidence": {
        "type": "string"
       },
       "fix": {
        "type": "string"
       },
       "status": {
        "enum": [
         "open",
         "accepted",
         "declined",
         "fixed"
        ]
       },
       "reason": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "title",
       "severity"
      ]
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "items"
   ]
  },
  "block_graph": {
   "type": "object",
   "properties": {
    "type": {
     "const": "graph"
    },
    "title": {
     "type": "string"
    },
    "nodes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "group": {
        "enum": [
         "entry",
         "module",
         "boundary",
         "data",
         "external",
         "test",
         "changed",
         "affected",
         "safe",
         "unknown"
        ]
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     }
    },
    "edges": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/edge"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "nodes",
    "edges"
   ]
  },
  "block_flowchart": {
   "type": "object",
   "properties": {
    "type": {
     "const": "flowchart"
    },
    "title": {
     "type": "string"
    },
    "nodes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "start",
         "step",
         "decision",
         "end"
        ]
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     }
    },
    "edges": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/edge"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "nodes",
    "edges"
   ]
  },
  "block_decision": {
   "type": "object",
   "properties": {
    "type": {
     "const": "decision"
    },
    "title": {
     "type": "string"
    },
    "factors": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "options": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "status": {
        "enum": [
         "chosen",
         "viable",
         "eliminated"
        ]
       },
       "eliminated_by": {
        "type": "string"
       },
       "why": {
        "type": "string"
       },
       "cells": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "rating": {
           "enum": [
            "pass",
            "weak",
            "fail"
           ]
          },
          "text": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "rating"
         ]
        }
       }
      },
      "additionalProperties": false,
      "required": [
       "label",
       "cells"
      ]
     },
     "minItems": 1
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "factors",
    "options"
   ]
  },
  "block_architecture": {
   "type": "object",
   "properties": {
    "type": {
     "const": "architecture"
    },
    "title": {
     "type": "string"
    },
    "zones": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     },
     "minItems": 1
    },
    "components": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "zone": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "user",
         "channel",
         "service",
         "model",
         "retrieval",
         "store",
         "tool",
         "system",
         "human",
         "guard",
         "ops"
        ]
       },
       "tech": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "details": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/pair"
        }
       },
       "side_effect": {
        "type": "boolean"
       },
       "flag": {
        "$ref": "#/$defs/flag"
       },
       "variants": {
        "$ref": "#/$defs/ids"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "zone"
      ]
     },
     "minItems": 1
    },
    "links": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "from": {
        "type": "string"
       },
       "to": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "trust": {
        "enum": [
         "trusted",
         "untrusted"
        ]
       },
       "flag": {
        "$ref": "#/$defs/flag"
       },
       "variants": {
        "$ref": "#/$defs/ids"
       }
      },
      "additionalProperties": false,
      "required": [
       "from",
       "to"
      ]
     }
    },
    "flows": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "steps": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/flowstep"
        },
        "minItems": 1
       },
       "variants": {
        "$ref": "#/$defs/ids"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "title",
       "steps"
      ]
     }
    },
    "variants": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "note": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     }
    },
    "reach": {
     "$ref": "#/$defs/reach"
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "zones",
    "components"
   ]
  },
  "block_model": {
   "type": "object",
   "properties": {
    "type": {
     "const": "model"
    },
    "title": {
     "type": "string"
    },
    "areas": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     }
    },
    "tables": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "area": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "fact",
         "dimension",
         "bridge",
         "hub",
         "link",
         "satellite",
         "staging",
         "table"
        ]
       },
       "grain": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "history": {
        "type": "string"
       },
       "flag": {
        "$ref": "#/$defs/flag"
       },
       "columns": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string"
          },
          "type": {
           "type": "string"
          },
          "key": {
           "enum": [
            "pk",
            "fk",
            "bk"
           ]
          },
          "note": {
           "type": "string"
          },
          "personal": {
           "type": "boolean"
          },
          "mask": {
           "type": "string"
          },
          "history": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "name"
         ]
        }
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "columns"
      ]
     },
     "minItems": 1
    },
    "relations": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "from": {
        "type": "string"
       },
       "to": {
        "type": "string"
       },
       "on": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "cardinality": {
        "enum": [
         "1:1",
         "1:n",
         "n:1",
         "n:n"
        ]
       }
      },
      "additionalProperties": false,
      "required": [
       "from",
       "to"
      ]
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "type",
    "tables"
   ]
  },
  "block_nested": {
   "type": "object",
   "properties": {
    "type": {
     "const": "nested"
    },
    "title": {
     "type": "string"
    },
    "boxes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "parent": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "user",
         "channel",
         "service",
         "model",
         "retrieval",
         "store",
         "tool",
         "system",
         "human",
         "guard",
         "ops"
        ]
       },
       "tech": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "details": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/pair"
        }
       },
       "side_effect": {
        "type": "boolean"
       },
       "flag": {
        "$ref": "#/$defs/flag"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ]
     },
     "minItems": 1
    },
    "levels": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "open": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "open"
      ]
     }
    },
    "links": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "from": {
        "type": "string"
       },
       "to": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "trust": {
        "enum": [
         "trusted",
         "untrusted"
        ]
       },
       "flag": {
        "$ref": "#/$defs/flag"
       }
      },
      "additionalProperties": false,
      "required": [
       "from",
       "to"
      ]
     }
    },
    "flows": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "steps": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/flowstep"
        },
        "minItems": 1
       },
       "variants": {
        "$ref": "#/$defs/ids"
