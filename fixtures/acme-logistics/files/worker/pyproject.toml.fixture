[project]
name = "acme-worker"
version = "0.4.0"
requires-python = ">=3.11"
dependencies = [
    "pika==1.3.2",
    "psycopg[binary]==3.1.18",
    "requests==2.32.3",
]

[project.scripts]
acme-worker = "acme_worker.__main__:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
